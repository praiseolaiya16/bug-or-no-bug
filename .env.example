# Copy this file to .env (at the project root) and fill in real values.
# Never commit .env. backend/app.py loads it via python-dotenv.

# Gemini API key used by backend/analyzers/llm_review.py.
# Without this, /api/analyze and /api/results still work — the LLM side is
# just reported as unavailable instead of scored.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the Gemini model (default: gemini-3.5-flash-lite —
# chosen for its higher free-tier daily quota vs. full "flash" models).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: override the Flask port (default: 5001 — not 5000, since
# macOS AirPlay Receiver listens there by default on many machines).
# PORT=5001
